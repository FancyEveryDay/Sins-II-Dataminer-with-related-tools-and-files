{
    "version": 0,
    "make_dead_on_parent_buff_made_dead": true,
    "make_dead_on_distance_to_parent_buff_exceeded":
    {
        "distance": "spread_corruption_radius_value",
        "use_center_xz_distance": true
    },
    "restart_other_stacked_buffs_when_started": false,
    "time_actions": [
    {
        "execution_interval_value": "spread_corruption_interval_value",
        "action_group":
        {
            "actions": [
            {
                "action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "add_corruption",
                    "corruption_add_value": "spread_corruption_strength_value",
                    "planet_corruption_strength_modifier_type": "planet_corruption_strength",
                    "planet_corruption_strength_modifier_unit":
                    {
                        "unit_type": "previous_spawner"
                    }
                }]
            }]
        }
    }]
}
