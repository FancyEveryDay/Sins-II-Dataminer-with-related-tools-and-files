{
    "version": 0,
	"active_duration": "particle_decay_duration_value",
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "replace_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "trigger_event_actions": [
    {
        "trigger_event_type": "on_buff_started",
        "action_group":
        {
            "actions": [
            {
                "constraint":
				{					
					"constraint_type": "unit_passes_unit_constraint",
					"unit":
					{
						"unit_type": "current_spawner"
					},
					"unit_constraint":
                    {
                        "constraint_type": "has_corruption_at_or_above_threshold",
                        "threshold": 0.9
                    }
				},
				"action_type": "use_unit_operators_on_single_unit",
				"destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "apply_buff",
                    "buff": "dlc3_herald_support_capital_ship_particle_decay_drain_antimatter"
                }]
            }]
        }
    }],
	"unit_mutations": [
        "disable_can_use_active_abilities",
		"disable_can_passively_regenerate_antimatter"
    ],
    "gui":
    {
        "hud_icon": "particle_decay_hud_icon",
        "name": "dlc3_herald_support_capital_ship_particle_decay_ability_name",
		"is_visible_within_unit_tooltip": true,
        "visibility_scope": "negative"
    }
}
