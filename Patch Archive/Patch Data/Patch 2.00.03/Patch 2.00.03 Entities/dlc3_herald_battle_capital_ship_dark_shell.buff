{
    "version": 0,
    "active_duration": "dark_shell_duration_value",
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "restart_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "trigger_event_actions": [
    {
        "trigger_event_type": "on_buff_started",
        "action_group":
        {
            "actions": [
            {
                "constraint":
                {
                    "constraint_type": "unit_passes_target_filter",
                    "unit":
                    {
                        "unit_type": "current_spawner"
                    },
                    "target_filter_id": "dark_shell_is_battleship_target_filter"
                },
                "action_type": "start_buff_effect",
                "effect_definition":
                {
                    "binding": "unit_skin",
                    "mesh_point": "center",
                    "effect_by_size":
                    {
                        "small_unit": "dlc3_herald_battle_capital_ship_dark_shell_buff_on_self_small",
                        "medium_unit": "dlc3_herald_battle_capital_ship_dark_shell_buff_on_self_medium",
                        "large_unit": "dlc3_herald_battle_capital_ship_dark_shell_buff_on_self_large"
                    }
                }
            },
            {
                "constraint":
                {
                    "constraint_type": "unit_passes_target_filter",
                    "unit":
                    {
                        "unit_type": "current_spawner"
                    },
                    "target_filter_id": "dark_shell_is_not_battleship_target_filter"
                },
                "action_type": "start_buff_effect",
                "effect_definition":
                {
                    "binding": "unit_skin",
                    "mesh_point": "center",
                    "effect_by_size":
                    {
                        "small_unit": "dlc3_herald_battle_capital_ship_dark_shell_buff_on_target_small",
                        "medium_unit": "dlc3_herald_battle_capital_ship_dark_shell_buff_on_target_medium",
                        "large_unit": "dlc3_herald_battle_capital_ship_dark_shell_buff_on_target_large"
                    }
                }
            }]
        }
    },
    {
        "trigger_event_type": "on_current_spawner_damaged",
        "action_group":
        {
            "constraint":
            {
                "constraint_type": "value_comparison",
                "value_a": "uniforms_current_spawner_current_shields",
                "comparison_type": "less_than_equal_to",
                "value_b": "fixed_zero"
            },
            "actions": [
            {
                "action_type": "make_buff_dead"
            }]
        }
    },
    {
        "trigger_event_type": "on_try_prevent_damage",
        "action_group":
        {
            "constraint":
            {
                "constraint_type": "damage_can_be_propagated"
            },
            "actions": [
            {
                "action_type": "prevent_damage",
                "damage_prevented_value": "dark_shell_damage_prevented_value"
            },
            {
                "action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "add_corruption",
                    "corruption_add_value": "dark_shell_corruption_conversion_value"
                }]
            }]
        }
    }],
    "unit_mutations": [
        "adaptive_force_field_active"
    ],
    "unit_modifiers": [
    {
        "buff_unit_modifier_id": "dark_shell_max_shield_modifier"
    }],
    "gui":
    {
        "hud_icon": "dlc3_herald_battle_capital_ship_dark_shell_ability_hud_icon",
        "name": "dlc3_herald_battle_capital_ship_dark_shell_ability_name",
        "visibility_scope": "positive"
    }
}
