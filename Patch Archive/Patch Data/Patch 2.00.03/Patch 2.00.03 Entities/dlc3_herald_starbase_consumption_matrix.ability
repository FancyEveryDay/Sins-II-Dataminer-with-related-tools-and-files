{
    "version": 0,
    "action_data_source": "dlc3_herald_starbase_consumption_matrix",
	"level_source": "unit_item",
    "active_actions":
    {
        "cooldown_time": "consumption_matrix_cooldown_time",
        "actions":
        {
            "actions": [
            {
                "action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "apply_buff",
                    "buff": "dlc3_herald_starbase_consumption_matrix_on_self"
                },
				{
                    "operator_type": "play_point_effect",
                    "effect_definition":
                    {
                        "binding": "action_data_source",
                        "mesh_point": "center",
                        "effect": "dlc3_herald_starbase_consumption_matrix_activation"
                    }
                }]
            }]
        },
        "auto_cast":
        {
            "enabled_by_default_behavior": "always",
            "caster_constraint":
            {
                "constraint_type": "composite_and",
				"constraints":[
                {
                    "constraint_type": "unit_passes_unit_constraint",
                    "unit":
                    {
                        "unit_type": "current_spawner"
                    },
                    "unit_constraint":
                    {
                        "constraint_type": "weapon_has_target"
                    }
                },
				{
					"constraint_type": "has_valid_targets_in_radius",
					"radius_origin_unit":
					{
						"unit_type": "current_spawner"
					},
					"target_filter_id": "consumption_matrix_target_filter",
					"radius_value": "consumption_matrix_radius",
					"target_count_value": "consumption_matrix_autocast_min_target_count"
				}]
            }
        }
    },
    "gui":
    {
        "hud_icon": "dlc3_herald_starbase_consumption_matrix_unit_item_hud_icon",
        "name": "dlc3_herald_starbase_consumption_matrix_unit_item_name",
        "description": "dlc3_herald_starbase_consumption_matrix_unit_item_description",
		"targeting":
        {
            "targeting_type": "radius",
            "values":
            {
                "radius": "consumption_matrix_radius"
            }
        },
        "tooltip_line_groups": [
        {
            "header_text": "tooltip.aura_tooltip_lines_sub_header_label",
			"lines": [
            {
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.radius",
                "value_id": "consumption_matrix_radius"
            },
			{
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.corruption_consumed",
                "value_id": "consumption_matrix_max_corruption_consumption_per_tick",
