{
    "version": 0,
    "active_duration": "starbase_teleport_charge_down_duration_value",
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "restart_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "trigger_event_actions": [
    {
        "trigger_event_type": "on_buff_started",
        "action_group":
        {
            "actions": [
            {
                "action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "play_point_effect",
                    "effect_definition":
                    {
                        "binding": "action_data_source",
                        "mesh_point": "center",
                        "effect": "starbase_teleport_charge_arrival"
                    }
                }]
            },
            {
                "action_type": "start_buff_effect",
                "effect_definition":
                {
                    "binding": "action_data_source",
                    "mesh_point": "center",
                    "effect": "starbase_teleport_charge_charge_down"
                }
            }]
        }
    }],
    "unit_mutations": [
        "disable_can_update_ability_cooldown_progress",
        "disable_can_use_weapons"
    ],
    "gui":
    {
        "hud_icon": "dlc3_herald_starbase_teleporter_unit_item_hud_icon",
        "name": "dlc3_herald_starbase_teleporter_unit_item_name",
        "is_visible_within_unit_tooltip": true,
        "visibility_scope": "negative"
    }
}
