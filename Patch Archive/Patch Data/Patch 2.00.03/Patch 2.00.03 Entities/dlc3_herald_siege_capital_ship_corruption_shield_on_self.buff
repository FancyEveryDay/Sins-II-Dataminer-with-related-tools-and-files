{
    "version": 0,
    "make_dead_on_all_finite_time_actions_done": true,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "replace_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
	"time_actions": [
    {
        "execution_interval_value": "fixed_one",
        "execution_interval_count_value": "corruption_shield_execution_count_value",
        "action_group":
        {           
			"actions": [
            {
				"action_type": "change_buff_memory_float_value",
				"float_variable": "corruption_consumed",
				"math_operators": [
				{
					"operator_type": "assign",
					"operand_value": "corruption_shield_current_curruption"
				},
				{
					"operator_type": "min",
					"operand_value": "corruption_shield_max_corruption_consumed_per_tick"
				}]
			},
			{
                 "constraint":
				{
					"constraint_type": "value_comparison",
					"value_a": "corruption_shield_current_curruption",
					"comparison_type": "greater_than",
					"value_b": "fixed_zero"
				},
				"action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "remove_corruption",
                    "corruption_remove_value": "corruption_shield_max_corruption_consumed_per_tick",
                    "actual_removed_corruption_float_variable": "corruption_consumed"
                },
				{
                    "operator_type": "repair_damage",
                    "affect_type": "shields_only",
                    "repair_value": "corruption_shield_shields_restored_value"
                }]
            }]
        }
    }],
    "trigger_event_actions": [
    {
        "trigger_event_type": "on_buff_started",
        "action_group":
        {
            "actions": [
            {
                "action_type": "start_buff_effect",
                "effect_definition":
                {
                    "binding": "unit_skin",
                    "mesh_point": "center",
                    "effect": "dlc3_herald_siege_capital_ship_corruption_shield_duration"
                }
            }]
        }
    }],
	"gui":
    {
        "hud_icon": "corruption_shield_hud_icon",
        "name": "dlc3_herald_siege_capital_ship_corruption_shield_ability_name",
        "visibility_scope": "positive",
        "tooltip_line_groups": [
        {
            "lines": [
            {
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.corruption_consumed",
                "value_id": "corruption_shield_max_corruption_consumed_per_tick",
				"value_color": "negative",
				"value_float_format": "one_decimal_place",
				"value_suffix": "per_second"
            },
			{
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.shield_restore_rate",
                "value_id": "corruption_shield_shields_restored_value",
                "value_float_format": "two_decimal_place",
				"value_suffix": "per_second",
				"is_resolved_value": true
            }]
        }]
    }
}
