{
    "version": 0,
    "active_duration": "confusion_bolt_duration",
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "replace_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
	"trigger_event_actions": [
    {
        "trigger_event_type": "on_buff_started",
        "action_group":
        {
            "actions": [
            {
                "action_type": "start_buff_effect",
                "effect_definition":
                {
                    "binding": "unit_skin",
                    "mesh_point": "center",
                    "effect_by_size":
                    {
                        "small_unit": "dlc3_herald_support_capital_ship_confusion_bolt_buff_small",
                        "medium_unit": "dlc3_herald_support_capital_ship_confusion_bolt_buff_medium",
                        "large_unit": "dlc3_herald_support_capital_ship_confusion_bolt_buff_large"
                    }
                }
            },
			{
                "constraint":
				{
					"constraint_type": "unit_passes_unit_constraint",
					"unit":
					{
						"unit_type": "first_spawner"
					},
					"unit_constraint":
                    {
                        "constraint_type": "has_corruption_at_or_above_threshold",
                        "threshold": 0.5
                    }
				},
				"action_type": "use_unit_operators_on_units_in_radius_of_unit",
                "radius_origin_unit":
                {
                    "unit_type": "current_spawner"
                },
                "radius_value": "confusion_bolt_aoe_radius",
                "operators": [
                {
                    "constraint":
                    {
                        "constraint_type": "unit_passes_target_filter",
                        "unit":
                        {
                            "unit_type": "operand_destination"
                        },
                        "target_filter_id": "confusion_bolt_secondary_target_filter"
                    },
                    "operator_type": "apply_buff",
                    "buff": "dlc3_herald_support_capital_ship_confusion_bolt_on_secondary_targets"
                }]
            }]
        }
    }],
    "weapon_modifiers": [
    {
        "buff_weapon_modifier_id": "confusion_bolt_modifier"
    }],
    "gui":
    {
        "hud_icon": "confusion_bolt_hud_icons",
        "name": "dlc3_herald_support_capital_ship_confusion_bolt_ability_name",
		"is_visible_within_unit_tooltip": true,
        "visibility_scope": "negative"
    }
}
