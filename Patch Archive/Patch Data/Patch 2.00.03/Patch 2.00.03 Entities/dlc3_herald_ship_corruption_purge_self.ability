    },
    "active_actions":
    {
        "cooldown_time": "dlc3_herald_ship_corruption_purge_cooldown_time_value",
        "actions":
        {
            "actions": [
            {
                "constraint":
                {
                    "constraint_type": "unit_passes_unit_constraint",
                    "unit":
                    {
                        "unit_type": "current_spawner"
                    },
                    "unit_constraint":
                    {
                        "constraint_type": "can_purge_corruption",
                        "minimum_purge_amount": 0.0
                    }
                },
                "action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "apply_buff",
                    "buff": "dlc3_herald_ship_corruption_purge"
                }]
            }]
        },
        "auto_cast":
        {
            "enabled_by_default_behavior": "never",
            "caster_constraint":
            {
                "constraint_type": "unit_passes_unit_constraint",
                "unit":
                {
                    "unit_type": "current_spawner"
                },
                "unit_constraint":
                {
                    "constraint_type": "can_purge_corruption",
                    "value_source": "constraint_params"
                }
            }
        },
        "ai_only_auto_cast":
        {
            "enabled_by_default_behavior": "always",
            "caster_constraint":
            {
                "constraint_type": "composite_or",
                "constraints": [
                {
                    "constraint_type": "corruption_threshold_is_reached",
                    "unit":
                    {
                        "unit_type": "current_spawner"
                    }
                },
                {
                    "constraint_type": "unit_passes_unit_constraint",
                    "unit":
                    {
                        "unit_type": "current_spawner"
                    },
                    "unit_constraint":
                    {
                        "constraint_type": "composite_and",
                        "constraints": [
                        {
                            "constraint_type": "has_missing_hull",
                            "percentage_missing_threshold": 0.5
                        },
                        {
                            "constraint_type": "can_purge_corruption",
                            "value_source": "constraint_params"
                        }]
                    }
                }]
            }
        }
    },
