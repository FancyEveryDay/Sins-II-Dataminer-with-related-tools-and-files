{
    "version": 0,
    "make_dead_on_source_ability_released": true,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "trigger_event_actions": [
    {
        "trigger_event_type": "on_current_spawner_damaged",
        "action_group":
        {
            "constraint":
			{
				"constraint_type": "value_comparison",
				"value_a": "retributive_capacitive_shield_damage_taken_by_shield",
				"comparison_type": "greater_than",
				"value_b": "fixed_zero"
			},
            "actions": [
            {
                "action_type": "change_buff_memory_float_value",
                "float_variable": "damage_absorbed",
                "math_operators": [
                {
                    "operator_type": "add",
                    "operand_value": "retributive_capacitive_shield_damage_taken_by_shield"
                }]
            },
			{
                "constraint":
				{
					"constraint_type": "value_comparison",
					"value_a": "retributive_capacitive_shield_damage_taken_tally",
					"comparison_type": "greater_than_equal_to",
					"value_b": "retributive_capacitive_shield_damage_absorb_blast_threshold"
				},
				"action_type": "use_unit_operators_on_units_in_radius_of_unit",
				"include_radius_origin_unit": false,
                "radius_origin_unit":
                {
                    "unit_type": "current_spawner"
                },
                "radius_value": "retributive_capacitive_shield_radius",
                "operators": [
                {
                    "constraint":
                    {
						"constraint_type": "unit_passes_target_filter",
						"unit":
						{
							"unit_type": "operand_destination"
						},
						"target_filter_id": "retributive_capacitive_shield_target_filter"
					},
                    "operator_type": "apply_damage",
                    "damage_source": "weapon",
                    "damage_affect_type": "hull_and_armor_and_shields",
                    "damage_value": "retributive_capacitive_shield_blast_damage_amount",
                    "penetration_value": "retributive_capacitive_shield_blast_damage_pierce",
					"can_damage_be_propagated": false
                }]
            },
			{
                "constraint":
				{
					"constraint_type": "value_comparison",
					"value_a": "retributive_capacitive_shield_damage_taken_tally",
					"comparison_type": "greater_than_equal_to",
					"value_b": "retributive_capacitive_shield_damage_absorb_blast_threshold"
				},
				"action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "play_point_effect",
                    "effect_definition":
                    {
                        "binding": "action_data_source",
                        "mesh_point": "center",
                        "effect": "retributive_capacitive_shield_blast"
                    }
                }]
            },
			{
                "constraint":
				{
					"constraint_type": "value_comparison",
					"value_a": "retributive_capacitive_shield_damage_taken_tally",
					"comparison_type": "greater_than_equal_to",
					"value_b": "retributive_capacitive_shield_damage_absorb_blast_threshold"
				},
				"action_type": "change_buff_memory_float_value",
                "float_variable": "damage_absorbed",
                "math_operators": [
                {
                    "operator_type": "subtract",
                    "operand_value": "retributive_capacitive_shield_damage_absorb_blast_threshold"
                }]
            },
			{
                "action_type": "change_buff_memory_float_value",
                "float_variable": "blast_threshold_status",
                "math_operators": [
                {
                    "operator_type": "assign",
                    "operand_value": "retributive_capacitive_shield_damage_taken_tally"
                },
				{
                    "operator_type": "divide",
                    "operand_value": "retributive_capacitive_shield_damage_absorb_blast_threshold"
                }]
            }]
        }
    }],
	"gui":
    {
        "hud_icon": "dlc3_herald_retributive_capacitive_shield_unit_item_hud_icon",
        "name": "dlc3_herald_retributive_capacitive_shield_unit_item_name",				
		"is_visible_within_unit_tooltip": true,
        "visibility_scope": "positive",
        "tooltip_line_groups": [
        {
            "lines": [
            {
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.damage_absorbed_by_shield_threshold",
                "value_id": "retributive_capacitive_shield_blast_threshold_status",
				"value_float_format": "percentage_one_decimal_place",
				"value_color": "positive",
				"is_resolved_value": true
            }]
        }]
    }
}
