{
    "version": 0,
    "make_dead_on_parent_buff_made_dead": true,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
	"time_actions": [
    {
        "execution_interval_value": "fixed_one",
        "action_group":
        {           
			"actions": [
			{
				"constraint":
				{
					"constraint_type": "value_comparison",
					"value_a": "uniforms_current_spawner_current_shields",
					"comparison_type": "equal_to",
					"value_b": "fixed_zero"
				},
				"action_type": "make_buff_dead"
			},
            {
                "constraint":
				{
					"constraint_type": "value_comparison",
					"value_a": "uniforms_current_spawner_current_shields",
					"comparison_type": "greater_than",
					"value_b": "fixed_zero"
				},
				"action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "add_corruption",
                    "corruption_add_value": "overpower_corruption_gain_per_tick"
                }]
            }]
        }
    }],    
	"unit_modifiers": [
    {
        "buff_unit_modifier_id": "overpower_shield_regeneration_buff_scalar_modifier"
    }],
	"gui":
    {
        "hud_icon": "overpower_hud_icon",
        "name": "dlc3_herald_titan_overpower_ability_name",
        "visibility_scope": "positive",
        "tooltip_line_groups": [
        {
            "lines": [
            {
                "rendering_type": "buff_unit_modifier",
                "unit_modifier_id": "overpower_shield_regeneration_buff_scalar_modifier"
            },
			{
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.corruption_gain",
                "value_id": "overpower_corruption_gain_per_tick",
				"value_color": "positive",
				"value_suffix": "per_second"
            }]
        }]
    }
}
