{
    "version": 0,
    "make_dead_on_parent_buff_made_dead": true,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
	"time_actions": [
    {
        "execution_interval_value": "fixed_one",
        "action_group":
        {           
			"actions": [
			{
				"constraint":
				{
					"constraint_type": "composite_or",
					"constraints": [
					{
						"constraint_type": "value_comparison",
						"value_a": "uniforms_current_spawner_current_shields",
						"comparison_type": "greater_than",
						"value_b": "fixed_zero"
					},
					{
						"constraint_type": "value_comparison",
						"value_a": "overpower_current_curruption",
						"comparison_type": "less_than",
						"value_b": "overpower_corruption_consumption_per_tick"
					}]
				},
				"action_type": "make_buff_dead"
			},
			{
                "action_type": "change_buff_memory_float_value",
                "float_variable": "corruption_consumed",
                "math_operators": [
                {
                    "operator_type": "assign",
                    "operand_value": "overpower_corruption_consumption_per_tick"
                },
				{
                    "operator_type": "min",
                    "operand_value": "overpower_current_curruption"
                }]
            },
            {
                "constraint":
				{
					"constraint_type": "value_comparison",
					"value_a": "uniforms_current_spawner_current_shields",
					"comparison_type": "equal_to",
					"value_b": "fixed_zero"
				},
				"action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "remove_corruption",
                    "corruption_remove_value": "overpower_corruption_consumption_per_tick",
					"actual_removed_corruption_float_variable": "corruption_consumed"
                }]
            }]
        }
    }],    
	"unit_modifiers": [
    {
        "buff_unit_modifier_id": "overpower_armor_regeneration_buff_scalar_modifier"
    }],
	"gui":
    {
        "hud_icon": "overpower_hud_icon",
        "name": "dlc3_herald_titan_overpower_ability_name",
        "visibility_scope": "positive",
        "tooltip_line_groups": [
        {
            "lines": [
            {
                "rendering_type": "buff_unit_modifier",
                "unit_modifier_id": "overpower_armor_regeneration_buff_scalar_modifier"
            },
			{
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.corruption_consumed",
                "value_id": "overpower_corruption_consumption_per_tick",
				"value_color": "negative",
				"value_suffix": "per_second"
            }]
        }]
    }
}
