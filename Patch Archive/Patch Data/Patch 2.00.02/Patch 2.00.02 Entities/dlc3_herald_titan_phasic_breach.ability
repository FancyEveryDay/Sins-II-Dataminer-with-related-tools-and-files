        "targeting_type": "position_targeted",
        "range": "phasic_breach_primary_range",
        "move_alignment":
        {
            "type": "yaw",
            "angle": 0.0,
            "allow_opposite_angle": false
        },
        "firing_angle": 10.0,
        "auto_cast":
        {
			"enabled_by_default_behavior": "always",
            "caster_constraint":
