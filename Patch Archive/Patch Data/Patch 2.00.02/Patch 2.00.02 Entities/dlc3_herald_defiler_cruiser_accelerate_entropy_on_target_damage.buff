{
    "version": 0,
    "make_dead_on_parent_buff_made_dead": true,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
	"stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "time_actions": [
	{
		"execution_interval_value": "fixed_one",
        "action_group":
        {
            "actions": [
            {
                "action_type": "use_unit_operators_on_single_unit",
                "source_unit":
                {
                    "unit_type": "first_spawner"
                },
				"destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "apply_damage",
                    "damage_source": "ability",
                    "damage_affect_type": "hull_and_armor_and_shields",
                    "damage_value": "accelerate_entropy_damage_per_tick_amount",
                    "penetration_value": "accelerate_entropy_damage_pierce"
                }]
            }]
        }
    }],
    "gui":
    {
        "hud_icon": "dlc3_herald_defiler_cruiser_accelerate_entropy_ability_hud_icon",
        "name": "dlc3_herald_defiler_cruiser_accelerate_entropy_ability_name",
        "visibility_scope": "negative",
        "tooltip_line_groups": [
        {
            "lines": [
            {
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.damage_rate",
                "value_id": "accelerate_entropy_damage_per_tick_amount",
                "value_suffix": "per_second"
            },
			{
                "visible_if_value_zero": true,
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.armor_penetration",
                "value_id": "accelerate_entropy_damage_pierce"
            }]
        }]
    }
}
