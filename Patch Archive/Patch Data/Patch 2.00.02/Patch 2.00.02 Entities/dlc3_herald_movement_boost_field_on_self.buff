{
    "version": 0,
	"make_dead_on_source_ability_released": true,
	"make_dead_on_all_finite_time_actions_done": true,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "replace_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "time_actions": [
    {
        "execution_interval_value": "fixed_one",
		"execution_interval_count_value": "movemment_boost_field_duration",
		"action_group":
        {			
			"actions": [
            {
				"constraint":
				{
					"constraint_type": "value_comparison",
					"value_a": "movemment_boost_field_corruption_available",
					"comparison_type": "less_than",
					"value_b": "movemment_boost_field_corruption_consumed_on_tick_base"
				},
                "action_type": "make_buff_dead"
            },
			{
                "constraint":
				{
					"constraint_type": "value_comparison",
					"value_a": "movemment_boost_field_corruption_available",
					"comparison_type": "greater_than_equal_to",
					"value_b": "movemment_boost_field_corruption_consumed_on_tick_base"
				},
				"action_type": "use_unit_operators_on_units_in_radius_of_unit",
                "radius_origin_unit":
                {
                    "unit_type": "current_spawner"
                },
                "radius_value": "movemment_boost_field_radius",
                "operators": [
                {
                    "constraint":
                    {
						"constraint_type": "unit_passes_target_filter",
						"unit":
						{
							"unit_type": "operand_destination"
						},
						"target_filter_id": "movemment_boost_field_target_filter"
					},
                    "operator_type": "apply_buff",
                    "buff": "dlc3_herald_movement_boost_field_on_target"
                }]
            },
			{                
                "constraint":
				{
					"constraint_type": "value_comparison",
					"value_a": "movemment_boost_field_corruption_available",
					"comparison_type": "greater_than_equal_to",
					"value_b": "movemment_boost_field_corruption_consumed_on_tick_base"
				},
				"action_type": "change_buff_memory_float_value",
                "float_variable": "corruption_consumed",
                "math_operators": [
                {
                    "operator_type": "assign",
                    "operand_value": "movemment_boost_field_corruption_consumed_on_tick_base"
                },
				{
                    "operator_type": "min",
                    "operand_value": "movemment_boost_field_corruption_available"
                }]
            },
			{
                "constraint":
				{
					"constraint_type": "value_comparison",
					"value_a": "movemment_boost_field_corruption_available",
					"comparison_type": "greater_than_equal_to",
					"value_b": "movemment_boost_field_corruption_consumed_on_tick_base"
				},
				"action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "remove_corruption",
                    "corruption_remove_value": "movemment_boost_field_corruption_consumed_on_tick_used",
                    "actual_removed_corruption_float_variable": "corruption_consumed"
                }]
            }]
        }		
    }],
	"trigger_event_actions": [
    {
        "trigger_event_type": "on_buff_started",
        "action_group":
        {
            "actions": [
            {
                "action_type": "start_buff_effect",
                "effect_definition":
                {
                    "binding": "action_data_source",
                    "mesh_point": "center",
                    "effect": "movemment_boost_field_active"
                }
            }]
        }
    }],
	"gui":
    {
        "hud_icon": "dlc3_herald_movement_boost_field_unit_icon_hud_icon",
        "name": "dlc3_herald_movement_boost_field_unit_item_name",
		"visibility_scope": "negative",
        "tooltip_line_groups": [
        {
			"lines": [
			{
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.corruption_consumed",
                "value_id": "movemment_boost_field_corruption_consumed_on_tick_base",
				"value_color": "negative",
				"value_suffix": "per_second"
            }]
        }]
    }
}
