{
    "version": 0,
    "make_dead_on_current_spawner_made_dead": false,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "trigger_event_actions": [
	{
		"trigger_event_type": "on_buff_started",
        "action_group":
        {
            "actions": [
            {
                "action_type": "change_buff_memory_float_value",
                "float_variable": "proc_chance",
                "math_operators": [
                {
                    "operator_type": "assign",
                    "operand_value": "afterimage_phase_echo_chance"
                }]
            }]
        }
	},
    {
        "trigger_event_type": "on_current_spawner_try_make_dead",
        "action_group":
        {
            "constraint":
            {
                "constraint_type": "composite_and",
				"constraints": [
				{			
					"constraint_type": "unit_passes_target_filter",
					"unit":
					{
						"unit_type": "current_spawner",
						"redirection": "current_gravity_well_primary_fixture"
					},
					"target_filter_id": "uniforms_owned_planets"
				},
				{
					"constraint_type": "value_comparison",
					"value_a": "afterimage_was_invulnerable_value",
					"comparison_type": "equal_to",
					"value_b": "fixed_zero"
				},
				{
					"constraint_type": "random_chance",
					"chance_value": "afterimage_proc_chance_value"
				}]
            },
            "actions": [
            {
                "action_type": "abort_make_dead"
            },
			{
                "action_type": "change_buff_memory_float_value",
                "float_variable": "proc_chance",
                "math_operators": [
                {
                    "operator_type": "assign",
                    "operand_value": "fixed_one"
                }]
            },
            {
                "action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                
				{
                    "operator_type": "apply_buff",
                    "buff": "dlc3_herald_unlock_afterimage_on_self_invulnerable"
                }]
            }]
        }
    }],
    "gui":
    {
        "hud_icon": "dlc3_herald_unlock_afterimage_research_subject_hud_icon",
        "name": "dlc3_herald_afterimage_ability_name",
        "visibility_scope": "positive",
		"tooltip_line_groups": [
        {
            "lines": [
            {
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.chance_to_phase_echo_on_death",
                "value_id": "afterimage_phase_echo_chance",
                "value_float_format": "percentage_one_decimal_place"
            }]
        }]
    }
}
