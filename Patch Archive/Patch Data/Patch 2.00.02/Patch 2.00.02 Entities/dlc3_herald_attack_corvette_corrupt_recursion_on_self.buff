{
    "version": 0,
    "make_dead_on_current_spawner_made_dead": false,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "trigger_event_actions": [
    {
        "trigger_event_type": "on_current_spawner_try_make_dead",
        "action_group":
        {
            "constraint":
            {
                "constraint_type": "composite_and",
				"constraints": [
				{			
					"constraint_type": "unit_passes_unit_constraint",
					"unit":
					{
						"unit_type": "current_spawner"
					},
					"unit_constraint":
                    {
                        "constraint_type": "has_corruption_at_or_above_threshold",
                        "threshold": 0.5
                    }
				},
				{
					"constraint_type": "value_comparison",
					"value_a": "corrupt_recursion_was_invulnerable_value",
					"comparison_type": "equal_to",
					"value_b": "fixed_zero"
				}]
            },
            "actions": [
            {
                "action_type": "abort_make_dead"
            },
			{
                "constraint":
				{			
					"constraint_type": "unit_passes_unit_constraint",
					"unit":
					{
						"unit_type": "current_spawner"
					},
					"unit_constraint":
                    {
                        "constraint_type": "has_corruption_at_or_above_threshold",
                        "threshold": 0.9
                    }
				},
				"action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "apply_buff",
                    "buff": "dlc3_herald_attack_corvette_corrupt_recursion_on_self_damage_bonus"
                }]
            },
            {
                "action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "apply_buff",
                    "buff": "dlc3_herald_attack_corvette_corrupt_recursion_on_self_invulnerable"
                }]
            }]
        }
    }],
    "gui":
    {
        "hud_icon": "dlc3_herald_attack_corvette_corrupt_recursion_ability_hud_icon",
        "name": "dlc3_herald_attack_corvette_corrupt_recursion_ability_name",
        "visibility_scope": "positive"
    }
}
