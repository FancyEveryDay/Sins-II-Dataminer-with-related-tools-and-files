{
    "version": 0,
    "make_dead_on_source_ability_released": true,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "trigger_event_actions": [
    {
        "trigger_event_type": "on_current_spawner_augment_pending_damage_as_source",
        "action_group":
        {
            "constraint":
            {
                "constraint_type": "composite_and",
                "constraints": [
                {
                    "constraint_type": "damage_has_damage_source",
                    "damage_source": "weapon"
                },
				{
					"constraint_type": "damage_has_weapon_tag",
					"weapon_tag": "beam"
				},
				{
					"constraint_type": "value_comparison",
					"value_a": "immolation_beam_target_corruption_available",
					"comparison_type": "greater_than",
					"value_b": "fixed_zero"
				}]
            },
            "actions": [
            {
				"action_type": "change_buff_memory_float_value",
                "float_variable": "corruption_consumed",
                "math_operators": [
                {
                    "operator_type": "assign",
                    "operand_value": "immolation_beam_corruption_conversion_max"
                },
				{
                    "operator_type": "multiply",
                    "operand_value": "immolation_beam_corruption_conversion_rate"
                },
				{
                    "operator_type": "min",
                    "operand_value": "immolation_beam_target_corruption_available"
                }]
			},
			{
				"action_type": "change_buff_memory_float_value",
                "float_variable": "damage_augment",
                "math_operators": [
                {
                    "operator_type": "assign",
                    "operand_value": "immolation_beam_corruption_consumed"
                },
				{
                    "operator_type": "divide",
                    "operand_value": "immolation_beam_corruption_conversion_rate"
                }]
			},
			{                
				"action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "trigger_event_destination"
                },
                "operators": [
                {
                    "operator_type": "remove_corruption",
                    "corruption_remove_value": "immolation_beam_corruption_consumed",
                    "actual_removed_corruption_float_variable": "corruption_consumed"
                },
				{
                    "operator_type": "play_point_effect",
                    "effect_definition":
                    {
                        "binding": "action_data_source",
                        "mesh_point": "center",
                        "effect": "immolation_beam_activation"
                    }
                }]
            },
            {
                "action_type": "augment_damage",
                "bonus_damage_value": "immolation_beam_damaged_augment_value"
            }]
        }
    }]
}
