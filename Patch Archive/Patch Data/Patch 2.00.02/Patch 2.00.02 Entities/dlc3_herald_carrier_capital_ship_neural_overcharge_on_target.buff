{
    "version": 0,
    "make_dead_on_parent_buff_made_dead": true,
    "make_dead_on_distance_to_parent_buff_exceeded":
    {
        "distance": "neural_overcharge_radius_value"
    },
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "time_actions": [
    {
        "execution_interval_value": "fixed_one",
        "action_group":
        {
            "actions": [
            {
                "action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "add_corruption",
                    "corruption_add_value": "neural_overcharge_corruption_gain_over_time_value"
                }]
            }]
        }
    }],
    "trigger_event_actions": [
    {
        "trigger_event_type": "on_buff_started",
        "action_group":
        {
            "actions": [
            {
                "constraint":
                {
                    "constraint_type": "composite_not",
                    "constraint":
                    {
                        "constraint_type": "unit_comparison",
                        "unit_a":
                        {
                            "unit_type": "current_spawner"
                        },
                        "unit_b":
                        {
                            "unit_type": "previous_spawner"
                        }
                    }
                },
                "action_type": "start_buff_effect",
                "effect_definition":
                {
                    "binding": "unit_skin",
                    "mesh_point": "center",
                    "effect_by_size":
                    {
                        "small_unit": "dlc3_herald_carrier_capital_ship_neural_overcharge_buff_on_target_small",
                        "medium_unit": "dlc3_herald_carrier_capital_ship_neural_overcharge_buff_on_target_medium",
                        "large_unit": "dlc3_herald_carrier_capital_ship_neural_overcharge_buff_on_target_large"
                    }
                }
            }]
        }
    }],
    "unit_modifiers": [
    {
        "buff_unit_modifier_id": "neural_overcharge_antimatter_restore_rate_modifier"
    }],
    "gui":
    {
        "hud_icon": "dlc3_herald_carrier_capital_ship_neural_overcharge_ability_hud_icon",
        "name": "dlc3_herald_carrier_capital_ship_neural_overcharge_ability_name",
        "visibility_scope": "positive",
        "tooltip_line_groups": [
        {
            "lines": [
            {
                "rendering_type": "buff_unit_modifier",
                "unit_modifier_id": "neural_overcharge_antimatter_restore_rate_modifier"
            }]
        }]
    }
}
